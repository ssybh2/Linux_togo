#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${LINUX_TO_GO_LIB_DIR:-}" ]]; then LIB_DIR="$LINUX_TO_GO_LIB_DIR"
elif [[ -f "$SCRIPT_DIR/../lib/common.sh" ]]; then
  LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
  export LTG_NOMACHINE_PACKAGE_DIR="${LTG_NOMACHINE_PACKAGE_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)/packages}"
else LIB_DIR="$SCRIPT_DIR/../lib/linux-to-go"; fi
for module in common system clash-verge nomachine ros wizard; do
  [[ -r "$LIB_DIR/$module.sh" ]] || { echo "[ERROR] Missing module $module" >&2; exit 1; }
  source "$LIB_DIR/$module.sh"
done

usage() {
  cat <<'USAGE'
Linux To Go — clone and run ./setup.sh for the graphical installer
linux-to-go [--gui | --auto | --ros1 | --ros2 | --apps-only | --check | --status]
            [--skip-clash] [--skip-nomachine] [--dry-run]
Ubuntu 20.04: ROS1 Noetic (EOL; Clash 2.5.10 unavailable)
Ubuntu 22.04: ROS2 Humble; Ubuntu 24.04: ROS2 Jazzy
Architecture: automatically detected amd64 / arm64.
--dry-run prints the plan without sudo, downloads or system modifications.
USAGE
}

main() {
  local mode='' skip_clash=0 skip_nm=0 dry_run=0 arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help) usage; return ;;
      --skip-clash) skip_clash=1 ;;
      --skip-nomachine) skip_nm=1 ;;
      --dry-run) dry_run=1 ;;
      -ros1|--ros1|-ros2|--ros2|--apps-only|--check|--status|--auto|--gui)
        [[ -z "$mode" ]] || { log_error 'Choose only one mode'; return 2; }
        case "$arg" in -ros1|--ros1) mode=ros1 ;; -ros2|--ros2) mode=ros2 ;; *) mode="$arg" ;; esac ;;
      *) usage >&2; return 2 ;;
    esac
  done
  mode="${mode:---gui}"
  if [[ "$mode" == --gui ]]; then
    exec /usr/bin/python3 "$LIB_DIR/installer_gui.py" "$SCRIPT_DIR/linux-to-go" "$([[ "$dry_run" == 1 ]] && echo --dry-run || echo --live)"
  fi
  detect_system
  if [[ "$mode" == --status ]]; then print_status; return; fi
  validate_supported_system
  if [[ "$mode" == --auto ]]; then mode="$(terminal_wizard)"; fi
  if [[ "$mode" == --check ]]; then print_status; return; fi
  [[ "$mode" == --apps-only ]] || validate_ros_request "$mode"
  print_plan "$mode" "$skip_clash" "$skip_nm"
  [[ "$dry_run" != 1 ]] || { log_ok 'Dry run completed; no changes made'; return; }
  [[ "$skip_nm" == 1 ]] || preflight_nomachine
  install_common_packages "$mode"
  [[ "$skip_clash" == 1 ]] || install_clash_verge
  [[ "$skip_nm" == 1 ]] || install_nomachine
  [[ "$mode" == --apps-only ]] || install_requested_ros "$mode"
  log_ok 'Linux To Go completed'
  log_info 'Clash Verge: import your own subscription. NoMachine: sudo /usr/NX/bin/nxserver --status'
}
main "$@"
