#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${LINUX_TO_GO_LIB_DIR:-}" ]]; then
  LIB_DIR="$LINUX_TO_GO_LIB_DIR"
elif [[ -f "$SCRIPT_DIR/../lib/common.sh" ]]; then
  LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
  : "${LTG_NOMACHINE_PACKAGE_DIR:=$(cd "$SCRIPT_DIR/.." && pwd)/packages}"
  export LTG_NOMACHINE_PACKAGE_DIR
elif [[ -f "$SCRIPT_DIR/../lib/linux-to-go/common.sh" ]]; then
  LIB_DIR="$(cd "$SCRIPT_DIR/../lib/linux-to-go" && pwd)"
else
  LIB_DIR="/usr/local/lib/linux-to-go"
fi

for module in common system clash-verge nomachine ros; do
  if [[ ! -r "$LIB_DIR/$module.sh" ]]; then
    printf '[ERROR] Missing Linux To Go module: %s\n' "$LIB_DIR/$module.sh" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$LIB_DIR/$module.sh"
done

usage() {
  cat <<'USAGE'
Linux To Go - Ubuntu environment bootstrap

Usage:
  linux-to-go -ros1
  linux-to-go --ros1
  linux-to-go -ros2
  linux-to-go --ros2
  linux-to-go --apps-only   # Clash Verge + NoMachine; leave ROS unchanged
  linux-to-go --check       # Read-only installed-component checks
  linux-to-go --help

Supported combinations:
  Ubuntu 20.04 -> ROS 1 Noetic (-ros1)
  Ubuntu 22.04 -> ROS 2 Humble (-ros2)

Both amd64 and arm64 are supported.
USAGE
}

main() {
  if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage
    return 0
  fi

  local mode
  if [[ $# -eq 1 && ( "$1" == "--apps-only" || "$1" == "--check" ) ]]; then
    mode="$1"
  elif ! mode="$(parse_ros_mode "$@")"; then
    log_error "Choose one mode: -ros1, -ros2, --apps-only, or --check."
    usage >&2
    return 2
  fi

  detect_system
  log_info "Ubuntu ${LTG_UBUNTU_VERSION} detected"
  log_info "Architecture: ${LTG_ARCH}"

  if [[ "$mode" == "--check" ]]; then
    validate_supported_system
    if clash_is_installed; then log_ok 'Clash Verge is installed'; else log_warn 'Clash Verge is not installed'; fi
    if nomachine_is_installed; then log_ok 'NoMachine is installed'; else log_warn 'NoMachine is not installed'; fi
    if detect_ros2; then log_ok "ROS 2 ${LTG_DETECTED_ROS2_DISTRO} detected"; else log_info 'ROS 2 Humble not detected'; fi
    if detect_ros1; then log_ok "ROS 1 ${LTG_DETECTED_ROS1_DISTRO} detected"; else log_info 'ROS 1 Noetic not detected'; fi
    return 0
  fi

  # Strict compatibility validation happens before any package changes.
  if [[ "$mode" == "--apps-only" ]]; then
    validate_supported_system
    log_info 'Apps-only mode: ROS packages, ROS sources and shell configuration will not be changed.'
  else
    validate_ros_request "$mode"
    log_info "Requested target: $(target_ros_distro "$mode")"
  fi

  # Catch a missing local amd64 package before any download or package change.
  preflight_nomachine
  install_common_packages "$mode"
  install_clash_verge
  install_nomachine
  if [[ "$mode" != "--apps-only" ]]; then install_requested_ros "$mode"; fi

  log_ok "Linux To Go completed"
  log_info 'Open Clash Verge as your normal desktop user and import your own subscription. Check NoMachine with: sudo /usr/NX/bin/nxserver --status'
}

main "$@"
